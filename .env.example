# --- corpus and storage ---
VAULT=/vault                  # corpus root, mount READ-ONLY
DATA=/data                    # index + model cache, the only thing written

# --- exclusions (comma separated) ---
EXCLUDE_PARTS=.git,.obsidian  # path components excluded at any depth
EXCLUDE_PREFIX=               # path prefixes, e.g. secrets/,build/

# --- embedding ---
EMBED_MODEL_ID=minishlab/potion-multilingual-128M
MODEL_PATH=                   # empty = fetch by id; set to a dir for air-gapped

# --- fusion weights (production values) ---
W_VEC=1.0
W_BM=0.4
W_TITLE=0.6
RRF_K=10
TOPN=50

# --- cross-encoder reranker ---
RERANK_ENABLED=1              # 0 = pure RRF, the soft rollback lever
RERANK_POOL=10
RERANK_SNIPPET_CHARS=240
RERANK_MODEL_DIR=/app/reranker
RERANK_MAX_LENGTH=256

# --- service ---
PORT=8080
REINDEX_SEC=900
SYNONYMS_FILE=/app/synonyms.json
